<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <!-- Custom tab for Transparent Edge -->
        <tab id="transparentedge" translate="label" sortOrder="500">
            <label>Transparent Edge</label>
        </tab>

        <section id="transparentedge" translate="label" type="text" sortOrder="10"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>CDN Configuration</label>
            <tab>transparentedge</tab>
            <resource>TransparentEdge_CDN::configuration</resource>

            <!-- ═══════════════════════════════════════════ -->
            <!-- General Settings                           -->
            <!-- ═══════════════════════════════════════════ -->
            <group id="general" translate="label comment" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>General Settings</label>
                <comment>Configure your Transparent Edge CDN credentials. You can find them in the Transparent Edge Dashboard (dashboard.transparentcdn.com).</comment>

                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable</label>
                    <comment>Enable Transparent Edge CDN integration.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/general/enabled</config_path>
                </field>

                <field id="company_id" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Company ID</label>
                    <comment>Your Transparent Edge company identifier.</comment>
                    <config_path>transparentedge/general/company_id</config_path>
                    <validate>required-entry validate-digits</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="client_id" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Client ID</label>
                    <comment>OAuth2 Client ID for API authentication.</comment>
                    <config_path>transparentedge/general/client_id</config_path>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="client_secret" translate="label comment" type="obscure" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Client Secret</label>
                    <comment>OAuth2 Client Secret for API authentication.</comment>
                    <config_path>transparentedge/general/client_secret</config_path>
                    <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
                    <validate>required-entry</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <!-- Test Connection Button -->
                <field id="test_connection" translate="label" type="button" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Test Connection</label>
                    <frontend_model>TransparentEdge\CDN\Block\Adminhtml\System\Config\TestConnection</frontend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <!-- ═══════════════════════════════════════════ -->
            <!-- Cache Settings                             -->
            <!-- ═══════════════════════════════════════════ -->
            <group id="cache" translate="label comment" type="text" sortOrder="20"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Cache Settings</label>
                <comment>Configure Cache-Control TTLs sent to the CDN via origin headers. These control how long Transparent Edge Varnish caches your content.</comment>
                <depends>
                    <field id="transparentedge/general/enabled">1</field>
                </depends>

                <field id="html_ttl" translate="label comment" type="text" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>HTML CDN TTL (s-maxage)</label>
                    <comment>CDN cache lifetime for HTML pages in seconds. Default: 172800 (48 hours). Recommended for ecommerce: 14400 (4 hours).</comment>
                    <config_path>transparentedge/cache/html_ttl</config_path>
                    <validate>validate-digits</validate>
                </field>

                <field id="html_browser_ttl" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>HTML Browser TTL (max-age)</label>
                    <comment>Browser cache lifetime for HTML pages in seconds. Default: 3600 (1 hour). Recommended for ecommerce: 600 (10 minutes).</comment>
                    <config_path>transparentedge/cache/html_browser_ttl</config_path>
                    <validate>validate-digits</validate>
                </field>

                <field id="static_ttl" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Static Assets CDN TTL</label>
                    <comment>CDN cache lifetime for CSS, JS, images, fonts in seconds. Default: 2592000 (30 days).</comment>
                    <config_path>transparentedge/cache/static_ttl</config_path>
                    <validate>validate-digits</validate>
                </field>

                <field id="static_browser_ttl" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Static Assets Browser TTL</label>
                    <comment>Browser cache lifetime for static assets in seconds. Default: 86400 (1 day).</comment>
                    <config_path>transparentedge/cache/static_browser_ttl</config_path>
                    <validate>validate-digits</validate>
                </field>

                <field id="stale_while_revalidate" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Stale-While-Revalidate</label>
                    <comment>Serve stale content while fetching a fresh copy in the background. Default: 86400 (1 day).</comment>
                    <config_path>transparentedge/cache/stale_while_revalidate</config_path>
                    <validate>validate-digits</validate>
                </field>

                <field id="stale_if_error" translate="label comment" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Stale-If-Error</label>
                    <comment>Serve stale content if origin returns an error. Default: 86400 (1 day).</comment>
                    <config_path>transparentedge/cache/stale_if_error</config_path>
                    <validate>validate-digits</validate>
                </field>

                <field id="soft_purge" translate="label comment" type="select" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Soft Purge</label>
                    <comment>Mark content as stale instead of removing it immediately. Prevents cache stampede on high-traffic sites.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/cache/soft_purge</config_path>
                </field>

                <field id="refetch" translate="label comment" type="select" sortOrder="80"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Refetch on Invalidation</label>
                    <comment>Automatically fetch fresh content from origin after invalidation. Ensures the CDN always has a warm copy.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/cache/refetch</config_path>
                </field>
            </group>

            <!-- ═══════════════════════════════════════════ -->
            <!-- Per-page-type cache profiles               -->
            <!-- ═══════════════════════════════════════════ -->
            <group id="cache_profiles" translate="label comment" type="text" sortOrder="25"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Cache Profiles by Page Type</label>
                <comment><![CDATA[Different page types age at different speeds. Leave a field empty to inherit the value from Cache Settings.<br/><br/><strong>The homepage is the one that matters.</strong> When a block is served from Magento's <code>block_html</code> cache its product collection is never loaded, so the page is tagged with the generic product tag instead of one tag per product. The edge rarely caches the first render after a flush, so the stored homepage usually lacks the individual product keys and a product change does not purge it. A short fresh window with a long stale-while-revalidate makes it refresh on time anyway: visitors are still served instantly from the stale copy while one request revalidates behind it.]]></comment>
                <depends>
                    <field id="transparentedge/general/enabled">1</field>
                </depends>

                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Cache Profiles</label>
                    <comment>When disabled, every HTML page uses the single TTL from Cache Settings.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/cache_profiles/enabled</config_path>
                </field>

                <field id="home_ttl" translate="label comment" type="text" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Homepage CDN TTL (s-maxage)</label>
                    <comment>Seconds the homepage stays fresh at the edge. Default: 300 (5 minutes). Keep it short and rely on the stale window below.</comment>
                    <config_path>transparentedge/cache_profiles/home_ttl</config_path>
                    <validate>validate-digits</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>

                <field id="home_swr" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Homepage stale-while-revalidate</label>
                    <comment>Seconds the edge may keep serving the stale homepage while it revalidates in the background. Default: 86400 (24 hours). Nobody waits for the revalidation.</comment>
                    <config_path>transparentedge/cache_profiles/home_swr</config_path>
                    <validate>validate-digits</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>

                <field id="category_ttl" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Category CDN TTL (s-maxage)</label>
                    <comment>Empty inherits the HTML CDN TTL. Category pages are tagged reliably, so a long TTL plus invalidation is usually better.</comment>
                    <config_path>transparentedge/cache_profiles/category_ttl</config_path>
                    <validate>validate-digits</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>

                <field id="category_swr" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Category stale-while-revalidate</label>
                    <comment>Empty inherits the global stale-while-revalidate.</comment>
                    <config_path>transparentedge/cache_profiles/category_swr</config_path>
                    <validate>validate-digits</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>

                <field id="product_ttl" translate="label comment" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Product CDN TTL (s-maxage)</label>
                    <comment>Empty inherits the HTML CDN TTL.</comment>
                    <config_path>transparentedge/cache_profiles/product_ttl</config_path>
                    <validate>validate-digits</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>

                <field id="product_swr" translate="label comment" type="text" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Product stale-while-revalidate</label>
                    <comment>Empty inherits the global stale-while-revalidate.</comment>
                    <config_path>transparentedge/cache_profiles/product_swr</config_path>
                    <validate>validate-digits</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>

                <field id="cms_ttl" translate="label comment" type="text" sortOrder="80"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>CMS page CDN TTL (s-maxage)</label>
                    <comment>Empty inherits the HTML CDN TTL. CMS pages change rarely, so a longer TTL is usually safe.</comment>
                    <config_path>transparentedge/cache_profiles/cms_ttl</config_path>
                    <validate>validate-digits</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>

                <field id="cms_swr" translate="label comment" type="text" sortOrder="90"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>CMS page stale-while-revalidate</label>
                    <comment>Empty inherits the global stale-while-revalidate.</comment>
                    <config_path>transparentedge/cache_profiles/cms_swr</config_path>
                    <validate>validate-digits</validate>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>

            <!-- ═══════════════════════════════════════════ -->
            <!-- Warm-up Settings                           -->
            <!-- ═══════════════════════════════════════════ -->
            <group id="warmup" translate="label comment" type="text" sortOrder="30"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Cache Warm-up</label>
                <comment>Automatically warm the CDN cache after invalidation to ensure fast page loads for the first visitor.</comment>
                <depends>
                    <field id="transparentedge/general/enabled">1</field>
                </depends>

                <field id="enabled" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Warm-up</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/warmup/enabled</config_path>
                </field>

                <field id="homepage" translate="label" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Warm Homepage</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/warmup/homepage</config_path>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="categories" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Warm Category Pages</label>
                    <comment><![CDATA[Warm the category pages affected by an edit. Only those: saving a product warms the categories it belongs to, not the whole tree.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/warmup/categories</config_path>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="sitemap" translate="label comment" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Warm from Sitemap</label>
                    <comment>Parse the XML sitemap and warm all URLs found in it (up to 200).</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/warmup/sitemap</config_path>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="sitemap_url" translate="label comment" type="text" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Sitemap URL</label>
                    <comment>Full URL to your XML sitemap. Leave empty to use the default /sitemap.xml.</comment>
                    <config_path>transparentedge/warmup/sitemap_url</config_path>
                    <depends>
                        <field id="sitemap">1</field>
                    </depends>
                </field>

                <field id="rate_limit" translate="label comment" type="text" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>API Rate Limit (req/s)</label>
                    <comment><![CDATA[Maximum requests per second sent to the Transparent Edge API while warming. Default: 3.<br/><br/>This no longer throttles requests to your own site: warming is delegated to the platform, which re-fetches each object on every edge node without going through this server. Your origin still renders each warmed page roughly once — the re-fetches are collapsed across nodes for a given page, not across different pages. Use the hourly budget below to cap that cost; this setting only paces our calls to the API.]]></comment>
                    <config_path>transparentedge/warmup/rate_limit</config_path>
                    <validate>validate-digits validate-digits-range digits-range-1-10</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="hourly_budget" translate="label comment" type="text" sortOrder="65"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Hourly Warm-up Budget (URLs)</label>
                    <comment><![CDATA[Most URLs warmed per hour, counting every source: content edits, the CLI command and the periodic sweep. Default: 300. Anything over the cap is skipped, not queued — the edge still revalidates those pages on their first real request.<br/><br/>This is the backstop against your own editors generating load: warming is triggered by edits, and edits arrive in bursts. 0 removes the cap; only do that once you have measured what your origin takes.]]></comment>
                    <config_path>transparentedge/warmup/hourly_budget</config_path>
                    <validate>validate-digits</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="scheduled" translate="label comment" type="select" sortOrder="66"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Periodic Full Sweep</label>
                    <comment><![CDATA[Re-warm the homepage, categories, custom URLs and sitemap every 6 hours. Off by default.<br/><br/>A sweep re-fetches every listed URL whether or not anyone has asked for it, so it costs one origin render per URL, every time. Soft purge with stale-while-revalidate already revalidates pages on demand, at one render per page somebody actually wants. Turn this on only if your traffic is uneven enough for pages to go cold between visits.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/warmup/scheduled</config_path>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="custom_urls" translate="label comment" type="textarea" sortOrder="70"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Custom Warm-up URLs</label>
                    <comment>Additional URLs to warm after each invalidation. One per line. Can be relative (/my-page) or absolute (https://...).</comment>
                    <config_path>transparentedge/warmup/custom_urls</config_path>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <!-- ═══════════════════════════════════════════ -->
            <!-- i3 Image Optimization                      -->
            <!-- ═══════════════════════════════════════════ -->
            <group id="i3" translate="label comment" type="text" sortOrder="40"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>i3 Image Optimization</label>
                <comment>Transparent Edge i3 optimizes images on the fly at the CDN edge. This generates the VCL configuration for i3. After changing these settings, copy the generated VCL to your Transparent Edge Dashboard.</comment>
                <depends>
                    <field id="transparentedge/general/enabled">1</field>
                </depends>

                <field id="enabled" translate="label" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable i3</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/i3/enabled</config_path>
                </field>

                <field id="auto_webp" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Auto WebP/AVIF</label>
                    <comment>Automatically serve WebP or AVIF images to supporting browsers.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/i3/auto_webp</config_path>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="quality" translate="label comment" type="text" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Image Quality (%)</label>
                    <comment>JPEG/WebP quality. Default: 85. Lower = smaller files, higher = better quality.</comment>
                    <config_path>transparentedge/i3/quality</config_path>
                    <validate>validate-digits validate-digits-range digits-range-1-100</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="max_width" translate="label comment" type="text" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Maximum Width (px)</label>
                    <comment>Cap image width to prevent serving oversized images. Default: 2560. Set to 0 to disable.</comment>
                    <config_path>transparentedge/i3/max_width</config_path>
                    <validate>validate-digits</validate>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <!-- VCL Preview Button -->
                <field id="vcl_preview" translate="label" type="button" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Preview VCL</label>
                    <frontend_model>TransparentEdge\CDN\Block\Adminhtml\System\Config\VclPreview</frontend_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <!-- ═══════════════════════════════════════════ -->
            <!-- WPO (Web Performance Optimization)         -->
            <!-- ═══════════════════════════════════════════ -->
            <group id="wpo" translate="label comment" type="text" sortOrder="45"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Web Performance (WPO)</label>
                <comment>HTML optimizations to improve Core Web Vitals (LCP, CLS, FID). Applied at the origin before caching, benefiting all visitors.</comment>
                <depends>
                    <field id="transparentedge/general/enabled">1</field>
                </depends>

                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable WPO</label>
                    <comment>Enable HTML optimizations for better Core Web Vitals scores.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/wpo/enabled</config_path>
                </field>

                <field id="preload" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Preload Critical Resources</label>
                    <comment>Auto-detect and preload LCP image, critical CSS, and web fonts. Improves LCP (Largest Contentful Paint).</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/wpo/preload</config_path>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="lazyload" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Lazy Load Iframes &amp; Videos</label>
                    <comment>Defer loading of iframes (YouTube, Google Maps) and videos until they enter the viewport. Magento already handles images.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/wpo/lazyload</config_path>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>

                <field id="dns_prefetch" translate="label comment" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>DNS Prefetch &amp; Preconnect</label>
                    <comment>Auto-detect external domains (analytics, fonts, CDN) and add DNS prefetch/preconnect hints. Reduces connection latency for third-party resources.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/wpo/dns_prefetch</config_path>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>

            <!-- ═══════════════════════════════════════════ -->
            <!-- ═══════════════════════════════════════════ -->
            <!-- Security headers                           -->
            <!-- ═══════════════════════════════════════════ -->
            <group id="security" translate="label comment" type="text" sortOrder="45"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Security Headers</label>
                <comment><![CDATA[Written into the VCL the plugin generates, not sent from PHP, so they also cover static files, images and error pages — none of which reach Magento. After changing anything here, regenerate the VCL and redeploy it.]]></comment>

                <field id="nosniff" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>X-Content-Type-Options: nosniff</label>
                    <comment><![CDATA[Stops the browser guessing a file's type from its content. Safe to leave on.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/security/nosniff</config_path>
                </field>

                <field id="frame_options" translate="label" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>X-Frame-Options</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/security/frame_options</config_path>
                </field>
                <field id="frame_options_value" translate="label comment" type="text" sortOrder="21"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>X-Frame-Options value</label>
                    <comment><![CDATA[SAMEORIGIN or DENY. Use DENY only if nothing embeds the storefront in a frame.]]></comment>
                    <config_path>transparentedge/security/frame_options_value</config_path>
                    <depends><field id="frame_options">1</field></depends>
                </field>

                <field id="referrer_policy" translate="label" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Referrer-Policy</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/security/referrer_policy</config_path>
                </field>
                <field id="referrer_policy_value" translate="label" type="text" sortOrder="31"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Referrer-Policy value</label>
                    <config_path>transparentedge/security/referrer_policy_value</config_path>
                    <depends><field id="referrer_policy">1</field></depends>
                </field>

                <field id="permissions_policy" translate="label comment" type="select" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Permissions-Policy</label>
                    <comment><![CDATA[Off by default: this one has to match what your store actually uses. A generic policy can switch off payment or geolocation APIs that a module needs.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/security/permissions_policy</config_path>
                </field>
                <field id="permissions_policy_value" translate="label" type="text" sortOrder="41"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Permissions-Policy value</label>
                    <config_path>transparentedge/security/permissions_policy_value</config_path>
                    <depends><field id="permissions_policy">1</field></depends>
                </field>

                <field id="hsts" translate="label comment" type="select" sortOrder="50"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Strict-Transport-Security (HSTS)</label>
                    <comment><![CDATA[<strong>Off by default, and think before switching it on.</strong> Once a browser has seen this header it refuses to talk http to your domain for the whole max-age, and there is no way to call it back. If any part of the site, or any subdomain when you include them, is still served over http, it stops being reachable for visitors who have already been here.<br/><br/>Turn it on only when every part of the site is on https and you intend to keep it that way.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/security/hsts</config_path>
                </field>
                <field id="hsts_max_age" translate="label comment" type="text" sortOrder="51"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>HSTS max-age (seconds)</label>
                    <comment><![CDATA[Default 31536000 (one year). Start lower — 86400 — until you are sure, because this is how long a mistake lasts.]]></comment>
                    <validate>validate-digits</validate>
                    <config_path>transparentedge/security/hsts_max_age</config_path>
                    <depends><field id="hsts">1</field></depends>
                </field>
                <field id="hsts_subdomains" translate="label comment" type="select" sortOrder="52"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>HSTS: include subdomains</label>
                    <comment><![CDATA[Applies the same rule to every subdomain, including ones you may have forgotten.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/security/hsts_subdomains</config_path>
                    <depends><field id="hsts">1</field></depends>
                </field>
                <field id="hsts_preload" translate="label comment" type="select" sortOrder="53"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>HSTS: preload</label>
                    <comment><![CDATA[Asks browser vendors to ship the rule built in, so it applies even on a first visit. Getting back off the preload list takes months. Only has any effect with subdomains included, which the submission process requires.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/security/hsts_preload</config_path>
                    <depends><field id="hsts">1</field><field id="hsts_subdomains">1</field></depends>
                </field>

                <field id="csp" translate="label comment" type="select" sortOrder="60"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Content-Security-Policy</label>
                    <comment><![CDATA[Off by default. A policy that is slightly wrong takes the storefront's JavaScript down.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/security/csp</config_path>
                </field>
                <field id="csp_value" translate="label comment" type="textarea" sortOrder="61"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>CSP policy</label>
                    <comment><![CDATA[The full policy, e.g. <em>default-src 'self'; img-src 'self' data: https:</em>]]></comment>
                    <config_path>transparentedge/security/csp_value</config_path>
                    <depends><field id="csp">1</field></depends>
                </field>
                <field id="csp_enforce" translate="label comment" type="select" sortOrder="62"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enforce the CSP</label>
                    <comment><![CDATA[No (the default) sends it as Content-Security-Policy-Report-Only: browsers report what the policy would have blocked and block nothing. Run it that way, read the reports, and only switch to Yes once nothing legitimate is being reported.]]></comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/security/csp_enforce</config_path>
                    <depends><field id="csp">1</field></depends>
                </field>
            </group>

            <!-- ═══════════════════════════════════════════ -->
            <!-- Speculation Rules                          -->
            <!-- ═══════════════════════════════════════════ -->
            <group id="speculation" translate="label comment" type="text" sortOrder="46"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Speculation Rules</label>
                <comment>Instructs the browser to prefetch or prerender pages before the visitor clicks. Dramatically reduces perceived load time on internal navigation. Compatible with Chrome 109+, Edge 120+, Safari 18+.</comment>
                <depends>
                    <field id="transparentedge/general/enabled">1</field>
                </depends>

                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enable Speculation Rules</label>
                    <comment>Generate and serve a Speculation Rules JSON for the browser.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/speculation/enabled</config_path>
                </field>

                <field id="mode" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Mode</label>
                    <comment>Conservative: prefetch on click. Balanced: prefetch on hover (recommended). Aggressive: prefetch on viewport + prerender on click.</comment>
                    <source_model>TransparentEdge\CDN\Model\Config\Source\SpeculationMode</source_model>
                    <config_path>transparentedge/speculation/mode</config_path>
                    <depends><field id="enabled">1</field></depends>
                </field>

                <field id="injection" translate="label comment" type="select" sortOrder="30"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Header Injection</label>
                    <comment>PHP: inject from origin (compatible with all setups). VCL: inject from CDN edge (recommended, requires VCL deployment).</comment>
                    <source_model>TransparentEdge\CDN\Model\Config\Source\SpeculationInjection</source_model>
                    <config_path>transparentedge/speculation/injection</config_path>
                    <depends><field id="enabled">1</field></depends>
                </field>
            </group>

            <!-- ═══════════════════════════════════════════ -->
            <!-- Redis Management                           -->
            <!-- ═══════════════════════════════════════════ -->
            <group id="redis" translate="label comment" type="text" sortOrder="48"
                   showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Redis</label>
                <comment>Auto-detect and manage Redis for cache, FPC, and sessions. Changes modify app/etc/env.php directly — a backup is created before each change.</comment>
                <depends>
                    <field id="transparentedge/general/enabled">1</field>
                </depends>

                <field id="control" translate="label" type="button" sortOrder="10"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Redis Manager</label>
                    <frontend_model>TransparentEdge\CDN\Block\Adminhtml\System\Config\RedisControl</frontend_model>
                </field>
            </group>

            <!-- ═══════════════════════════════════════════ -->
            <!-- Advanced Settings                          -->
            <!-- ═══════════════════════════════════════════ -->
            <group id="advanced" translate="label comment" type="text" sortOrder="50"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Advanced</label>
                <depends>
                    <field id="transparentedge/general/enabled">1</field>
                </depends>

                <field id="admin_bypass" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Admin Bypass</label>
                    <comment>Set a cookie when admin logs in so the CDN serves uncached pages. Requires VCL support.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/advanced/admin_bypass</config_path>
                </field>

                <field id="debug" translate="label comment" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Debug Mode</label>
                    <comment>Add X-TE-Debug headers to responses showing tag counts. Disable in production.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/advanced/debug</config_path>
                </field>

                <field id="warmup_ssl_verify" translate="label comment" type="select" sortOrder="25"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Warm-up SSL Verify</label>
                    <comment>Verify SSL certificates during warm-up. Disable only in pre-production environments with self-signed certificates.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>transparentedge/advanced/warmup_ssl_verify</config_path>
                </field>

                <field id="log_level" translate="label comment" type="select" sortOrder="26"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Log Level</label>
                    <comment>Controls verbosity of var/log/transparentedge.log. Info is recommended for production. Debug generates high volume on busy sites.</comment>
                    <source_model>TransparentEdge\CDN\Model\Config\Source\LogLevel</source_model>
                    <config_path>transparentedge/advanced/log_level</config_path>
                </field>

                <field id="health_token" translate="label comment" type="text" sortOrder="27"
                       showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Health Check Token</label>
                    <comment>Token protecting the detailed status at /transparentedge/status/health. Without a token the endpoint reports liveness only; set one and call it with ?token=VALUE to get company ID, module version and cache backends. Use a long random value.</comment>
                    <config_path>transparentedge/advanced/health_token</config_path>
                </field>

                <field id="exclude_urls" translate="label comment" type="textarea" sortOrder="30"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Exclude URLs</label>
                    <comment>URL patterns to exclude from CDN caching. One per line. Supports wildcards (*). Checkout, customer, and cart pages are always excluded.</comment>
                    <config_path>transparentedge/advanced/exclude_urls</config_path>
                </field>

                <field id="exclude_cookies" translate="label comment" type="textarea" sortOrder="40"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Exclude Cookies</label>
                    <comment>Cookie names that should bypass CDN cache (for VCL generation). One per line.</comment>
                    <config_path>transparentedge/advanced/exclude_cookies</config_path>
                </field>
            </group>

        </section>
    </system>
</config>
